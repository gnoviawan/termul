{
  "start": {
    "name": "Digest",
    "trigger": {
      "kind": "manual"
    },
    "isolation": "shared_in_root",
    "graph": {
      "nodes": [
        {
          "id": "fetch",
          "label": "Fetch",
          "spec": {
            "kind": "http",
            "method": "GET",
            "url": "https://api.example.com/items",
            "headers": [],
            "body": null,
            "allowed_hosts": ["api.example.com"]
          }
        },
        {
          "id": "check",
          "label": "Check",
          "spec": {
            "kind": "condition",
            "left": "{{nodes.fetch.output.ok}}",
            "op": "eq",
            "right": "true"
          }
        },
        {
          "id": "stop",
          "label": "Stop",
          "spec": {
            "kind": "fail",
            "message": "fetch failed"
          }
        }
      ],
      "edges": [
        {
          "from": "trigger",
          "port": "out",
          "to": "fetch"
        },
        {
          "from": "fetch",
          "port": "out",
          "to": "check"
        },
        {
          "from": "fetch",
          "port": "error",
          "to": "stop"
        }
      ]
    }
  },
