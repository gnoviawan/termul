{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"]
  },
  "include": [
    "src/shared/**/*.ts",
    "src/renderer/**/*.test.ts",
    "src/renderer/**/*.test.tsx",
    "src/renderer/**/__tests__/**/*",
    "vitest.setup.ts",
    "scripts/**/*.test.ts",
    "tests/e2e/**/*.test.ts",
    "tests/e2e/seeded-server-args.ts",
    "scripts/acp-reference.ts",
    "scripts/validate-pr-body.ts",
    "scripts/canvas-eval/checks.ts",
    "scripts/canvas-eval/snapshot.ts",
    "scripts/canvas-eval/upstream.ts"
  ],
  "exclude": [
    "src/renderer/**/*.test.ts",
    "src/renderer/**/*.test.tsx",
    "src/renderer/**/__tests__/**/*"
  ]
}
