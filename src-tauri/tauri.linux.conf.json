{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBundleCommand": "node scripts/stage-linux-rg.mjs"
	},
	"bundle": {
		"externalBin": [],
		"linux": {
			"deb": {
				"files": {
					"/usr/lib/troupe/rg": "bin/linux-package/rg",
					"/usr/bin/termul-manager": "linux/termul-manager"
				},
				"conflicts": ["termul-manager"],
				"replaces": ["termul-manager"],
				"preInstallScript": "linux/deb-preinst.sh",
				"postInstallScript": "linux/deb-postinst.sh"
			},
			"rpm": {
				"files": {
					"/usr/lib/troupe/rg": "bin/linux-package/rg",
					"/usr/bin/termul-manager": "linux/termul-manager"
				},
				"conflicts": ["termul-manager"],
				"obsoletes": ["termul-manager"],
				"postInstallScript": "linux/rpm-post.sh"
			},
			"appimage": {
				"files": {
					"/usr/lib/troupe/rg": "bin/linux-package/rg"
				}
			}
		}
	}
}
