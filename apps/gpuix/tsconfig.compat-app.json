{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "../../src/renderer/*"
      ],
      "@renderer/*": [
        "../../src/renderer/*"
      ],
      "@shared/*": [
        "../../src/shared/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "#compat/fixture-dom": [
        "./tools/compat/fixtures/dom-contract.ts"
      ],
      "#compat/bench-dom": [
        "./tools/compat/bench/dom-contract.ts"
      ],
      "#app/web-root": [
        "./src/app/web-root-contract.ts"
      ]
    }
  },
  "include": [
    "src/native-patches.d.ts",
    "src/boot.tsx",
    "src/App.tsx",
    "tools/compat/fixtures/boot.tsx",
    "tools/compat/bench/app.tsx",
    "../../src/renderer/vite-env.d.ts"
  ],
  "exclude": []
}
