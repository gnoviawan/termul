# Upstream sources the self-built addon is made from. The zed commit is the
# gpuix repo's submodule pointer at GPUIX_COMMIT; build.sh refuses to build when
# they disagree. RUST_TOOLCHAIN matches gpuix's rust-toolchain.toml.
GPUIX_VERSION=0.11.0
GPUIX_REPO=https://github.com/remorses/gpuix.git
GPUIX_COMMIT=2e31b47ff6432ceebe70e7fc7b0f51a76d7d30cf
ZED_REPO=https://github.com/remorses/zed.git
ZED_COMMIT=f77e5cfe9dad04288566f00c66ecf3c58d6f84b3
RUST_TOOLCHAIN=1.97.1
