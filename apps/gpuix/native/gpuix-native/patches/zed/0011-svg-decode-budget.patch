@@ -0,0 +1,370 @@
+//! Work bounds for SVGs GPUI did not author, such as images in a chat reply.
+//! usvg and resvg have no budget of their own: a few hundred bytes of masks
+//! that reference each other expand to millions of conversions, and one filter
+//! primitive can cost the square of the canvas. Both checks below run before
+//! the expensive step and refuse the document instead.
+
+use std::collections::HashMap;
+use usvg::roxmltree::{Document, Node, NodeId};
+use usvg::tiny_skia_path::{Rect, Transform};
+
+/// Element instances (and text glyphs) usvg may create from one document once
+/// every reference instantiates its target. usvg converts one in roughly
+/// 15 µs, so this bounds a parse to a few hundred milliseconds.
+pub(super) const MAX_SVG_INSTANCES: u64 = 20_000;
+
+/// Pixel operations resvg may spend rasterizing one document: every shape's
+/// box, every offscreen layer, mask and clip, and each filter primitive's
+/// region weighted by its per-pixel cost. 64 full 2048 px canvases.
+pub(super) const MAX_SVG_RENDER_WORK: u64 = 64 * 2048 * 2048;
+
+/// Pixels of offscreen buffers resvg may hold at once besides the pixmap:
+/// 48 MiB, so a 2048 px image stays under 64 MiB.
+pub(super) const MAX_SVG_LAYER_PIXELS: u64 = 12 << 20;
+
+/// Distinct stylesheet `url(#…)` targets a document may have. A selector can
+/// apply each of them to any element, so each counts against every element.
+const MAX_STYLESHEET_TARGETS: usize = 64;
+
+/// How many element instances usvg would create from `doc`, or `None` when it
+/// is more than `limit`. Children count once, except inside `<defs>` and the
+/// other templates usvg only draws by reference; an `href="#id"` or a `url(#id)`
+/// in an attribute instantiates its target again (a marker once per vertex);
+/// a `url(#id)` in a `<style>` counts against every element; each character of
+/// text counts as a glyph. A reference back into its own chain counts nothing,
+/// as usvg drops it.
+pub(super) fn expanded_instances<'a, 'input>(doc: &'a Document<'input>, limit: u64) -> Option<u64> {
+    let ids: HashMap<&str, NodeId> = doc
+        .descendants()
+        .filter_map(|node| Some((node.attribute("id")?, node.id())))
+        .collect();
+    let target = |reference: &str| {
+        ids.get(reference)
+            .and_then(|id| doc.get_node(*id))
+            .filter(|node| !is_gradient(node))
+    };
+    let mut stylesheet: Vec<Node<'a, 'input>> = Vec::new();
+    for style in doc.descendants().filter(|n| n.has_tag_name_local("style")) {
+        for text in style.children().filter_map(|n| n.text()) {
+            for node in url_refs(text).filter_map(target) {
+                if !stylesheet.iter().any(|s| s.id() == node.id()) {
+                    stylesheet.push(node);
+                }
+            }
+        }
+    }
+    if stylesheet.len() > MAX_STYLESHEET_TARGETS {
+        return None;
+    }
+
+    enum State {
+        Open,
+        Done(u64),
+    }
+    struct Frame<'a, 'input> {
+        node: Node<'a, 'input>,
+        edges: Vec<(Node<'a, 'input>, u64)>,
+        next: usize,
+        sum: u64,
+    }
+    let edges = |node: Node<'a, 'input>| -> Vec<(Node<'a, 'input>, u64)> {
+        let mut edges = Vec::new();
+        let vertices = vertex_bound(&node);
+        let defs = node.has_tag_name_local("defs");
+        for child in node.children().filter(|child| child.is_element()) {
+            edges.push((child, u64::from(!defs && !is_template(&child))));
+        }
+        for attribute in node.attributes() {
+            let value = attribute.value();
+            if attribute.name() == "href"
+                && let Some(found) = value.strip_prefix('#').and_then(target)
+            {
+                edges.push((found, 1));
+            }
+            for found in url_refs(value).filter_map(target) {
+                edges.push((found, if is_marker(&found) { vertices } else { 1 }));
+            }
+        }
+        for found in &stylesheet {
+            edges.push((*found, if is_marker(found) { vertices } else { 1 }));
+        }
+        edges
+    };
+    let own = |node: &Node| -> u64 {
+        let glyphs: usize = if node.has_tag_name_local("text")
+            || node.has_tag_name_local("tspan")
+            || node.has_tag_name_local("textPath")
+        {
+            node.children().filter_map(|n| n.text()).map(|t| t.chars().count()).sum()
+        } else {
+            0
+        };
+        1 + glyphs as u64
+    };
+
+    let root = doc.root_element();
+    let mut state: HashMap<NodeId, State> = HashMap::new();
+    state.insert(root.id(), State::Open);
+    let mut stack = vec![Frame {
+        node: root,
+        edges: edges(root),
+        next: 0,
+        sum: own(&root),
+    }];
+    while let Some(frame) = stack.last_mut() {
+        if frame.sum > limit {
+            return None;
+        }
+        let Some(&(node, times)) = frame.edges.get(frame.next) else {
+            let done = stack.pop()?;
+            state.insert(done.node.id(), State::Done(done.sum));
+            match stack.last_mut() {
+                Some(parent) => {
+                    let times = parent.edges[parent.next].1;
+                    parent.sum = parent.sum.saturating_add(done.sum.saturating_mul(times));
+                    parent.next += 1;
+                }
+                None => return Some(done.sum),
+            }
+            continue;
+        };
+        match state.get(&node.id()) {
+            Some(State::Open) => frame.next += 1,
+            Some(State::Done(cost)) => {
+                frame.sum = frame.sum.saturating_add(cost.saturating_mul(times));
+                frame.next += 1;
+            }
+            None => {
+                state.insert(node.id(), State::Open);
+                stack.push(Frame {
+                    node,
+                    edges: edges(node),
+                    next: 0,
+                    sum: own(&node),
+                });
+            }
+        }
+    }
+    None
+}
+
+trait LocalName {
+    fn has_tag_name_local(&self, name: &str) -> bool;
+}
+
+impl LocalName for Node<'_, '_> {
+    fn has_tag_name_local(&self, name: &str) -> bool {
+        self.is_element() && self.tag_name().name() == name
+    }
+}
+
+fn is_gradient(node: &Node) -> bool {
+    node.has_tag_name_local("linearGradient") || node.has_tag_name_local("radialGradient")
+}
+
+/// An element usvg draws only where something references it, never in place.
+fn is_template(node: &Node) -> bool {
+    node.is_element()
+        && matches!(
+            node.tag_name().name(),
+            "defs" | "mask" | "clipPath" | "pattern" | "marker" | "symbol" | "filter"
+        )
+        || is_gradient(node)
+}
+
+fn is_marker(node: &Node) -> bool {
+    node.has_tag_name_local("marker")
+}
+
+/// At least the number of vertices a marker can be placed on.
+fn vertex_bound(node: &Node) -> u64 {
+    let data = node.attribute("d").or_else(|| node.attribute("points"));
+    data.map_or(2, |d| d.len() as u64 / 2 + 2)
+}
+
+/// The ids every `url(#id)` in `text` names, quoted or not.
+fn url_refs(text: &str) -> impl Iterator<Item = &str> {
+    text.match_indices("url(").filter_map(move |(at, _)| {
+        let rest = text[at + 4..].trim_start().trim_start_matches(['"', '\'']);
+        let id = rest.strip_prefix('#')?;
+        let end = id.find(|c: char| matches!(c, ')' | '"' | '\'') || c.is_whitespace())?;
+        Some(&id[..end])
+    })
+}
+
+/// What rasterizing a tree costs, as [`render_cost`] estimates it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) struct RenderCost {
+    /// Pixel operations: shape boxes, layers, masks and clips, and each filter
+    /// primitive's region times its per-pixel work.
+    pub work: u64,
+    /// Most pixels of offscreen layers, mask and clip buffers, filter results
+    /// and pattern tiles alive at once, the pixmap itself not included.
+    pub peak_layer_pixels: u64,
+}
+
+/// What resvg spends drawing `tree` with `transform` onto a `width` x
+/// `height` pixmap, or `None` once the work passes [`MAX_SVG_RENDER_WORK`] or
+/// the live layers pass [`MAX_SVG_LAYER_PIXELS`]. Boxes are clipped where
+/// resvg clips its layers, to twice the pixmap's size on every side; a pattern
+/// tile is not clipped at all.
+pub(super) fn render_cost(
+    tree: &usvg::Tree,
+    transform: Transform,
+    width: f32,
+    height: f32,
+) -> Option<RenderCost> {
+    let mut walk = Walk {
+        transform,
+        clip: Rect::from_xywh(-2.0 * width, -2.0 * height, 5.0 * width, 5.0 * height)?,
+        cost: RenderCost { work: 0, peak_layer_pixels: 0 },
+        live: 0,
+    };
+    walk.group(tree.root()).then_some(walk.cost)
+}
+
+struct Walk {
+    transform: Transform,
+    clip: Rect,
+    cost: RenderCost,
+    live: u64,
+}
+
+impl Walk {
+    /// Adds `pixels` of work plus one for the node itself; false once over budget.
+    fn work(&mut self, pixels: u64) -> bool {
+        self.cost.work = self.cost.work.saturating_add(pixels).saturating_add(1);
+        self.cost.work <= MAX_SVG_RENDER_WORK
+    }
+
+    /// Allocates `pixels` of layer for the duration of `draw`.
+    fn with_layer(&mut self, pixels: u64, draw: impl FnOnce(&mut Self) -> bool) -> bool {
+        self.live = self.live.saturating_add(pixels);
+        self.cost.peak_layer_pixels = self.cost.peak_layer_pixels.max(self.live);
+        let ok = self.live <= MAX_SVG_LAYER_PIXELS && draw(self);
+        self.live -= pixels;
+        ok
+    }
+
+    fn covered(&self, rect: Option<Rect>) -> (f32, f32) {
+        rect.and_then(|r| r.transform(self.transform))
+            .and_then(|r| r.intersect(&self.clip))
+            .map_or((0.0, 0.0), |r| (r.width().ceil() + 4.0, r.height().ceil() + 4.0))
+    }
+
+    fn area(&self, rect: Option<Rect>) -> u64 {
+        let (w, h) = self.covered(rect);
+        (w * h) as u64
+    }
+
+    fn group(&mut self, group: &usvg::Group) -> bool {
+        if !group.should_isolate() {
+            return group.children().iter().all(|node| self.node(node));
+        }
+        let (w, h) = self.covered(Some(group.abs_layer_bounding_box().to_rect()));
+        let pixels = (w * h) as u64;
+        self.with_layer(pixels, |walk| {
+            walk.work(pixels.saturating_mul(2))
+                && group.children().iter().all(|node| walk.node(node))
+                && walk.filters(group, pixels, w, h)
+                && walk.clips(group.clip_path(), pixels)
+                && walk.masks(group.mask(), pixels)
+        })
+    }
+
+    fn clips(&mut self, mut clip: Option<&usvg::ClipPath>, pixels: u64) -> bool {
+        while let Some(c) = clip {
+            if !self.with_layer(pixels, |walk| walk.work(pixels) && walk.group(c.root())) {
+                return false;
+            }
+            clip = c.clip_path();
+        }
+        true
+    }
+
+    fn masks(&mut self, mut mask: Option<&usvg::Mask>, pixels: u64) -> bool {
+        while let Some(m) = mask {
+            if !self.with_layer(pixels, |walk| walk.work(pixels) && walk.group(m.root())) {
+                return false;
+            }
+            mask = m.mask();
+        }
+        true
+    }
+
+    /// Each primitive keeps a result the size of the layer until the filter ends.
+    fn filters(&mut self, group: &usvg::Group, pixels: u64, w: f32, h: f32) -> bool {
+        let (sx, sy) = self.transform.pre_concat(group.abs_transform()).get_scale();
+        group.filters().iter().all(|filter| {
+            let results = pixels.saturating_mul(filter.primitives().len() as u64 + 1);
+            self.with_layer(results, |walk| {
+                filter.primitives().iter().all(|primitive| {
+                    let per_pixel = match primitive.kind() {
+                        usvg::filter::Kind::Morphology(m) => {
+                            let columns = (m.radius_x().get() * sx * 2.0).ceil().clamp(1.0, w);
+                            let rows = (m.radius_y().get() * sy * 2.0).ceil().clamp(1.0, h);
+                            (columns * rows) as u64
+                        }
+                        usvg::filter::Kind::Turbulence(t) => 4 * u64::from(t.num_octaves()).max(1),
+                        usvg::filter::Kind::ConvolveMatrix(c) => {
+                            u64::from(c.matrix().columns()) * u64::from(c.matrix().rows())
+                        }
+                        usvg::filter::Kind::GaussianBlur(_) | usvg::filter::Kind::DropShadow(_) => 8,
+                        usvg::filter::Kind::DiffuseLighting(_)
+                        | usvg::filter::Kind::SpecularLighting(_) => 16,
+                        usvg::filter::Kind::Image(image) => {
+                            if !walk.group(image.root()) {
+                                return false;
+                            }
+                            1
+                        }
+                        _ => 2,
+                    };
+                    walk.work(pixels.saturating_mul(per_pixel))
+                })
+            })
+        })
+    }
+
+    fn node(&mut self, node: &usvg::Node) -> bool {
+        match node {
+            usvg::Node::Group(group) => self.group(group),
+            usvg::Node::Path(path) => {
+                if !self.work(self.area(Some(path.abs_stroke_bounding_box()))) {
+                    return false;
+                }
+                let paints = [
+                    path.fill().map(|f| f.paint()),
+                    path.stroke().map(|s| s.paint()),
+                ];
+                paints.into_iter().flatten().all(|paint| match paint {
+                    usvg::Paint::Pattern(pattern) => {
+                        let (sx, sy) = self
+                            .transform
+                            .pre_concat(path.abs_transform())
+                            .pre_concat(pattern.transform())
+                            .get_scale();
+                        let tile = pattern.rect();
+                        let pixels = ((tile.width() * sx).ceil() * (tile.height() * sy).ceil()) as u64;
+                        self.with_layer(pixels, |walk| {
+                            walk.work(pixels) && walk.group(pattern.root())
+                        })
+                    }
+                    _ => true,
+                })
+            }
+            usvg::Node::Image(image) => {
+                self.work(self.area(Some(image.abs_bounding_box())))
+                    && match image.kind() {
+                        usvg::ImageKind::SVG(tree) => self.group(tree.root()),
+                        _ => true,
+                    }
+            }
+            usvg::Node::Text(text) => self.group(text.flattened()),
+        }
+    }
+}
