+#[test]
+fn counts_children_once() {
+    let svg = format!(r#"<svg {NS}><g><path d="M0 0h1v1z"/><path d="M0 0h1v1z"/></g></svg>"#);
+    assert_eq!(instances(&svg), Some(4));
+}
+
+#[test]
+fn counts_each_use_of_a_target() {
+    let svg = format!(
+        r##"<svg {NS}><defs><path id="p" d="M0 0h1v1z"/></defs><use href="#p"/><use href="#p"/><use href="#p"/></svg>"##
+    );
+    // svg, 3 uses and the path under each; defs and its path draw nowhere.
+    assert_eq!(instances(&svg), Some(7));
+}
+
+#[test]
+fn refuses_mask_fan_out() {
+    assert_eq!(instances(&mask_fan(24, false)), None);
+}
+
+#[test]
+fn refuses_mask_fan_out_through_a_stylesheet() {
+    assert_eq!(instances(&mask_fan(24, true)), None);
+}
+
+#[test]
+fn accepts_a_shallow_mask_chain() {
+    let count = instances(&mask_fan(6, false)).unwrap();
+    assert!(count < 500, "{count}");
+}
+
+#[test]
+fn refuses_use_fan_out_past_the_limit_and_accepts_it_below() {
+    let fan = |levels: usize| {
+        let groups: String = (0..levels)
+            .map(|i| format!(r##"<g id="a{}"><use href="#a{i}"/><use href="#a{i}"/></g>"##, i + 1))
+            .collect();
+        format!(
+            r##"<svg {NS}><defs><path id="a0" d="M0 0h1v1z"/>{groups}</defs><use href="#a{levels}"/></svg>"##
+        )
+    };
+    assert!(instances(&fan(12)).is_some());
+    assert_eq!(instances(&fan(16)), None);
+}
+
+#[test]
+fn a_reference_cycle_terminates() {
+    let svg = format!(
+        r##"<svg {NS}><defs><mask id="m" mask="url(#m)"><rect width="1" height="1"/></mask></defs><rect width="1" height="1" mask="url(#m)"/></svg>"##
+    );
+    assert!(instances(&svg).unwrap() < 10);
+}
+
+#[test]
+fn markers_count_per_vertex() {
+    let d: String = (0..10_000).map(|i| format!("L{i} {i}")).collect();
+    let svg = format!(
+        r##"<svg {NS}><defs><marker id="k"><g><g><path d="M0 0h1"/></g></g></marker></defs><path marker-mid="url(#k)" d="M0 0{d}"/></svg>"##
+    );
+    assert_eq!(instances(&svg), None);
+}
+
+#[test]
+fn text_counts_its_glyphs() {
+    let flood = format!(r#"<svg {NS}><text>{}</text></svg>"#, "W".repeat(60_000));
+    assert_eq!(instances(&flood), None);
+    let label = format!(r#"<svg {NS}><text>{}</text></svg>"#, "W".repeat(200));
+    assert_eq!(instances(&label), Some(202));
+}
+
+#[test]
+fn gradients_in_a_stylesheet_do_not_count_per_element() {
+    let gradients: String = (0..200)
+        .map(|i| format!(r##"<linearGradient id="g{i}"><stop offset="0"/></linearGradient>"##))
+        .collect();
+    let css: String = (0..200).map(|i| format!(".c{i}{{fill:url(#g{i})}}")).collect();
+    let svg = format!(r#"<svg {NS}><style>{css}</style><defs>{gradients}</defs><rect class="c1"/></svg>"#);
+    assert!(instances(&svg).is_some());
+}
+
+#[test]
+fn url_refs_reads_quoted_and_bare_ids() {
+    let ids: Vec<&str> = url_refs(r##"url(#a) url( "#b" ) url('#c') url(http://x/#d)"##).collect();
+    assert_eq!(ids, ["a", "b", "c"]);
+}
