+fn refuses_turbulence_with_many_octaves() {
+    let svg = format!(
+        r##"<svg {NS} viewBox="0 0 24 24"><filter id="f"><feTurbulence baseFrequency="0.5" numOctaves="100000"/></filter><rect width="24" height="24" filter="url(#f)"/></svg>"##
+    );
