+#[test]
+fn nested_layers_add_up() {
+    let svg = format!(
+        r##"<svg {NS} viewBox="0 0 24 24"><g opacity=".5"><g opacity=".5"><g opacity=".5"><path d="M0 0h24v24z"/></g></g></g></svg>"##
+    );
+    let cost = work(&svg, 1024.0).unwrap();
+    assert!(cost.peak_layer_pixels >= 3 * 1024 * 1024, "{cost:?}");
+}
