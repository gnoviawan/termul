+use super::*;
+use usvg::roxmltree::{Document, ParsingOptions};
+
+const NS: &str = r#"xmlns="http://www.w3.org/2000/svg""#;
+
+fn instances(svg: &str) -> Option<u64> {
+    let options = ParsingOptions {
+        allow_dtd: true,
+        ..Default::default()
+    };
+    let doc = Document::parse_with_options(svg, options).unwrap();
+    expanded_instances(&doc, MAX_SVG_INSTANCES)
+}
+
+fn work(svg: &str, side: f32) -> Option<RenderCost> {
+    let tree = usvg::Tree::from_str(svg, &usvg::Options::default()).unwrap();
+    let size = tree.size();
+    let scale = side / size.width().max(size.height());
+    let transform = Transform::from_scale(scale, scale);
+    render_cost(&tree, transform, size.width() * scale, size.height() * scale)
+}
+
+fn mask_fan(levels: usize, via_css: bool) -> String {
+    let mut defs = String::new();
+    let mut css = String::new();
+    for i in 0..levels {
+        let next = if i + 1 < levels && !via_css {
+            format!(r#" mask="url(#m{})""#, i + 1)
+        } else {
+            String::new()
+        };
+        if via_css && i + 1 < levels {
+            css += &format!("#m{i} rect{{mask:url(#m{})}}", i + 1);
+        }
+        defs += &format!(
+            r##"<mask id="m{i}"><rect width="24" height="24" fill="#fff"{next}/><rect width="12" height="12" fill="#fff"{next}/></mask>"##
+        );
+    }
+    format!(
+        r##"<svg {NS} viewBox="0 0 24 24"><style>{css}</style><defs>{defs}</defs><rect width="24" height="24" fill="#f00" mask="url(#m0)"/></svg>"##
+    )
+}
