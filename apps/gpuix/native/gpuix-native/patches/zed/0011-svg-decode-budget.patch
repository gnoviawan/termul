+#[test]
+fn refuses_a_canvas_wide_morphology_radius() {
+    let svg = format!(
+        r##"<svg {NS} viewBox="0 0 24 24"><filter id="f"><feMorphology radius="2000"/></filter><rect width="24" height="24" filter="url(#f)"/></svg>"##
+    );
+    assert_eq!(work(&svg, 48.0).map(|_| ()), Some(()));
+    assert_eq!(work(&svg, 2048.0), None);
+}
