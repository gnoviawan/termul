+#[test]
+fn counts_each_opacity_layer() {
+    let layers = |n: usize| {
+        let groups = r#"<g opacity=".5"><path d="M0 0h24v24z"/></g>"#.repeat(n);
+        format!(r#"<svg {NS} viewBox="0 0 24 24">{groups}</svg>"#)
+    };
+    assert!(work(&layers(8), 2048.0).is_some());
+    assert_eq!(work(&layers(64), 2048.0), None);
+}
+
+#[test]
+fn refuses_a_filter_region_far_past_the_canvas() {
+    let svg = format!(
+        r##"<svg {NS} viewBox="0 0 24 24" width="8000" height="8000"><filter id="f" x="-1000" y="-1000" width="3000" height="3000"><feGaussianBlur stdDeviation="1000"/></filter><rect width="24" height="24" filter="url(#f)"/></svg>"##
+    );
+    assert_eq!(work(&svg, 2048.0), None);
