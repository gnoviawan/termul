+#[test]
+fn a_plain_drawing_costs_about_its_area() {
+    let svg = format!(r##"<svg {NS} viewBox="0 0 24 24"><rect width="24" height="24" fill="#f00"/></svg>"##);
+    let cost = work(&svg, 2048.0).unwrap();
+    assert!(cost.work < 2 * 2052 * 2052, "{cost:?}");
+    assert_eq!(cost.peak_layer_pixels, 0);
+}
