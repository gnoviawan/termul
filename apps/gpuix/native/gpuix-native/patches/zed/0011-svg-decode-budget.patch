+        r##"<svg {NS} viewBox="0 0 24 24"><pattern id="p" width="100000" height="100000" patternUnits="userSpaceOnUse"><rect width="1" height="1"/></pattern><rect width="24" height="24" fill="url(#p)"/></svg>"##
+    );
