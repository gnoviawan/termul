+        let to_track = |track: crate::GridTrackSize| -> taffy::TrackSizingFunction {
+            match track {
+                // `minmax(<px>, 0fr)`, not `<px>`: under taffy 0.13 a content-sized item
+                // whose columns are all fixed-size adds nothing to its auto row's height
+                // (measured: a 38 px avatar cell left the row 20 px tall). A 0fr maximum
+                // takes no free space, so the track stays <px> wide.
+                crate::GridTrackSize::Fixed(px) => {
+                    minmax(length(round_to_device_pixel(px, scale_factor)), fr(0.0_f32))
+                }
+                crate::GridTrackSize::Fraction { fr: share, min } => {
+                    minmax(length(round_to_device_pixel(min, scale_factor)), fr(share))
+                }
+                crate::GridTrackSize::Auto => taffy::style_helpers::auto(),
+            }
+        };
