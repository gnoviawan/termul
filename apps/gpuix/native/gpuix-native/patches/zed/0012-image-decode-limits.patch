 }
 
+/// Every frame of an animated GIF or WebP as BGRA, within [`MAX_ANIMATION_BYTES`].
+pub(crate) fn decode_animation<'a>(
+    mut decoder: impl image::ImageDecoder + image::AnimationDecoder<'a>,
+) -> Result<SmallVec<[Frame; 1]>> {
+    check_image_size(&decoder)?;
+    decoder.set_limits(decode_limits())?;
+    let mut frames = SmallVec::new();
+    let mut kept = 0;
+    for frame in decoder.into_frames() {
+        match frame {
+            Ok(mut frame) => {
+                kept += frame.buffer().len();
+                if kept > MAX_ANIMATION_BYTES && !frames.is_empty() {
+                    log::warn!(
+                        "dropping animation frames after {} decoded ({MAX_ANIMATION_BYTES} bytes)",
+                        frames.len()
+                    );
+                    break;
+                }
+                // Convert from RGBA to BGRA.
+                for pixel in frame.buffer_mut().chunks_exact_mut(4) {
+                    pixel.swap(0, 2);
+                }
+                frames.push(frame);
+            }
+            Err(err) => log::debug!("Skipping animation frame due to decode error: {err}"),
+        }
+    }
+    anyhow::ensure!(
+        !frames.is_empty(),
+        "animation could not be decoded: all frames failed"
+    );
+    Ok(frames)
+}
