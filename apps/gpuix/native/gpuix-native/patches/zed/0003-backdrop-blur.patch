+    /// Blur everything painted so far inside `bounds`, like CSS
+    /// `backdrop-filter: blur(sigma)`. Paint the element's own background and
+    /// children after this call; they land on top of the blurred backdrop.
+    /// `opacity` is the element's own, which its paint has not applied yet.
+    ///
+    /// This method should only be called as part of the paint phase of element drawing.
+    pub fn paint_backdrop_blur(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        corner_radii: Corners<Pixels>,
+        sigma: Pixels,
+        opacity: f32,
+    ) {
+        self.invalidator.debug_assert_paint();
+        let opacity = self.element_opacity() * opacity.clamp(0.0, 1.0);
+        if opacity <= 0.0 || sigma <= px(0.0) {
+            return;
+        }
+        let backdrop = crate::Backdrop {
+            order: 0,
+            bounds: self.snap_bounds(bounds),
+            content_mask: self.snapped_content_mask(),
+            corner_radii: corner_radii.scale(self.scale_factor()),
+            sigma: sigma.scale(self.scale_factor()),
+            opacity,
+        };
+        self.next_frame.scene.insert_primitive(backdrop);
+    }
