+/// CSS `backdrop-filter: blur()`: a Gaussian blur of everything painted
+/// before it, inside `bounds` rounded by `corner_radii`. Renderers without
+/// support skip it, which leaves the content behind sharp.
+#[derive(Clone, Copy, Debug)]
+#[allow(missing_docs)]
+pub struct Backdrop {
+    pub order: DrawOrder,
+    pub bounds: Bounds<ScaledPixels>,
+    pub content_mask: ContentMask<ScaledPixels>,
+    pub corner_radii: Corners<ScaledPixels>,
+    /// Standard deviation of the Gaussian, as in CSS `blur(<length>)`.
+    pub sigma: ScaledPixels,
+    pub opacity: f32,
+}
+
+impl From<Backdrop> for Primitive {
+    fn from(backdrop: Backdrop) -> Self {
+        Primitive::Backdrop(backdrop)
+    }
+}
