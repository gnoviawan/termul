index 0000000..9790054
--- /dev/null
+++ b/crates/gpui_wgpu/src/backdrop.rs
@@ -0,0 +1,434 @@
+//! Backdrop blur (`gpui::Backdrop`, CSS `backdrop-filter: blur()`).
+//!
+//! Each backdrop splits the main pass. The frame region under it, plus a
+//! three-sigma halo, is copied into scratch texture `copy`. A horizontal
+//! Gaussian renders it into `blur_x`, downsampled by a power of two so the
+//! sigma is at most 4 texels (Skia's rule, so the result also looks like
+//! Chromium's); a vertical Gaussian renders `blur_x` into `blur_y` at that
+//! size; a composite upsamples `blur_y` onto the frame inside the element's
+//! rounded box. Content painted after the backdrop then draws on top. The
+//! frame must allow `COPY_SRC`; when the surface does not, backdrops are
+//! skipped and the content behind stays sharp.
+
+use bytemuck::{Pod, Zeroable};
+use gpui::Backdrop;
+use std::num::NonZeroU64;
+
+const SHADER: &str = include_str!("backdrop.wgsl");
+/// Above this sigma (in texels) the blur runs at half the resolution again.
+const MAX_SIGMA: f32 = 4.0;
+
+#[repr(C)]
+#[derive(Clone, Copy, Pod, Zeroable)]
+struct BackdropParams {
+    rect: [f32; 4],
+    sizes: [f32; 4],
+    source_map: [f32; 4],
+    taps: [f32; 4],
+    source_clamp: [f32; 4],
+    bounds: [f32; 4],
+    radii: [f32; 4],
+    misc: [f32; 4],
+}
+
+/// The copy region and uniform slots of one backdrop, decided before recording.
+#[derive(Clone, Copy)]
+struct Plan {
+    source_origin: [u32; 2],
+    source_size: [u32; 2],
+    /// Uniform offsets of the horizontal, vertical and composite passes.
+    offsets: [u32; 3],
+}
+
+struct Scratch {
+    size: [u32; 2],
+    copy: wgpu::Texture,
+    copy_group: wgpu::BindGroup,
+    blur_x_view: wgpu::TextureView,
+    blur_x_group: wgpu::BindGroup,
+    blur_y_view: wgpu::TextureView,
+    blur_y_group: wgpu::BindGroup,
+}
+
+pub(crate) struct BackdropBlur {
+    layout: wgpu::BindGroupLayout,
+    blur: wgpu::RenderPipeline,
+    composite: wgpu::RenderPipeline,
+    sampler: wgpu::Sampler,
+    format: wgpu::TextureFormat,
+    uniforms: wgpu::Buffer,
+    uniform_capacity: u64,
+    stride: u64,
+    scratch: Option<Scratch>,
+    plans: Vec<Option<Plan>>,
+}
+
+impl BackdropBlur {
+    pub(crate) fn new(device: &wgpu::Device, format: wgpu::TextureFormat) -> Self {
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("backdrop_layout"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: true,
+                        min_binding_size: NonZeroU64::new(
+                            std::mem::size_of::<BackdropParams>() as u64
+                        ),
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("backdrop_shader"),
+            source: wgpu::ShaderSource::Wgsl(SHADER.into()),
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("backdrop_pipeline_layout"),
+            bind_group_layouts: &[Some(&layout)],
+            immediate_size: 0,
+        });
+        let pipeline = |label: &str, blend: Option<wgpu::BlendState>| {
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(label),
+                layout: Some(&pipeline_layout),
+                vertex: wgpu::VertexState {
+                    module: &module,
+                    entry_point: Some("vs_backdrop"),
+                    buffers: &[],
+                    compilation_options: wgpu::PipelineCompilationOptions::default(),
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &module,
+                    entry_point: Some("fs_backdrop"),
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format,
+                        blend,
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                    compilation_options: wgpu::PipelineCompilationOptions::default(),
+                }),
+                primitive: wgpu::PrimitiveState {
+                    topology: wgpu::PrimitiveTopology::TriangleStrip,
+                    ..Default::default()
+                },
+                depth_stencil: None,
+                multisample: wgpu::MultisampleState::default(),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let blur = pipeline("backdrop_blur", None);
+        // The blurred frame is composited as premultiplied colour scaled by
+        // coverage, which is exact for the opaque content a window paints.
+        let composite = pipeline(
+            "backdrop_composite",
+            Some(wgpu::BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+        );
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("backdrop_sampler"),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        let alignment = u64::from(device.limits().min_uniform_buffer_offset_alignment);
+        let stride = (std::mem::size_of::<BackdropParams>() as u64).next_multiple_of(alignment);
+        let uniform_capacity = stride * 6;
+        let uniforms = Self::uniform_buffer(device, uniform_capacity);
+        Self {
+            layout,
+            blur,
+            composite,
+            sampler,
+            format,
+            uniforms,
+            uniform_capacity,
+            stride,
+            scratch: None,
+            plans: Vec::new(),
+        }
+    }
+
+    fn uniform_buffer(device: &wgpu::Device, size: u64) -> wgpu::Buffer {
+        device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("backdrop_uniforms"),
+            size,
+            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        })
+    }
+
+    /// Plans every backdrop of the frame and uploads their parameters. Call
+    /// once per frame before recording; a frame without backdrops releases
+    /// the scratch textures.
+    pub(crate) fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        backdrops: &[Backdrop],
+        target_size: [u32; 2],
+    ) {
+        self.plans.clear();
+        if backdrops.is_empty() {
+            self.scratch = None;
+            return;
+        }
+        let [width, height] = target_size;
+        let (w, h) = (width as f32, height as f32);
+        let mut params = Vec::with_capacity(backdrops.len() * 3);
+        for backdrop in backdrops {
+            let clip = backdrop.bounds.intersect(&backdrop.content_mask.bounds);
+            let x0 = clip.origin.x.0.floor().clamp(0.0, w) as u32;
+            let y0 = clip.origin.y.0.floor().clamp(0.0, h) as u32;
+            let x1 = clip.right().0.ceil().clamp(0.0, w) as u32;
+            let y1 = clip.bottom().0.ceil().clamp(0.0, h) as u32;
+            let sigma = backdrop.sigma.0;
+            if x1 <= x0 || y1 <= y0 || !(sigma > 0.0) || backdrop.opacity <= 0.0 {
+                self.plans.push(None);
+                continue;
+            }
+            let mut scale = 1.0f32;
+            let mut scaled_sigma = sigma;
+            while scaled_sigma > MAX_SIGMA {
+                scale *= 2.0;
+                scaled_sigma /= 2.0;
+            }
+            let taps = (scaled_sigma * 3.0).ceil();
+            let halo = (sigma * 3.0).ceil() as u32 + scale as u32;
+            let sx0 = x0.saturating_sub(halo);
+            let sy0 = y0.saturating_sub(halo);
+            let sx1 = (x1 + halo).min(width);
+            let sy1 = (y1 + halo).min(height);
+            let (sw, sh) = ((sx1 - sx0) as f32, (sy1 - sy0) as f32);
+            let (lw, lh) = ((sw / scale).ceil(), (sh / scale).ceil());
+            let low_clamp = [0.5, 0.5, lw - 0.5, lh - 0.5];
+            let unmasked = [0.0; 4];
+            params.push(BackdropParams {
+                rect: [0.0, 0.0, lw, lh],
+                sizes: [w, h, w, h],
+                source_map: [scale, 0.0, 0.0, 0.0],
+                taps: [scale, 0.0, scaled_sigma, taps],
+                source_clamp: [0.5, 0.5, sw - 0.5, sh - 0.5],
+                bounds: unmasked,
+                radii: unmasked,
+                misc: [1.0, 0.0, 0.0, 0.0],
+            });
+            params.push(BackdropParams {
+                rect: [0.0, 0.0, lw, lh],
+                sizes: [w, h, w, h],
+                source_map: [1.0, 0.0, 0.0, 0.0],
+                taps: [0.0, 1.0, scaled_sigma, taps],
+                source_clamp: low_clamp,
+                bounds: unmasked,
+                radii: unmasked,
+                misc: [1.0, 0.0, 0.0, 0.0],
+            });
+            let radii = backdrop.corner_radii;
+            params.push(BackdropParams {
+                rect: [x0 as f32, y0 as f32, (x1 - x0) as f32, (y1 - y0) as f32],
+                sizes: [w, h, w, h],
+                source_map: [1.0 / scale, -(sx0 as f32) / scale, -(sy0 as f32) / scale, 0.0],
+                taps: [0.0, 0.0, 1.0, 0.0],
+                source_clamp: low_clamp,
+                bounds: [
+                    backdrop.bounds.origin.x.0,
+                    backdrop.bounds.origin.y.0,
+                    backdrop.bounds.size.width.0,
+                    backdrop.bounds.size.height.0,
+                ],
+                radii: [
+                    radii.top_left.0,
+                    radii.top_right.0,
+                    radii.bottom_right.0,
+                    radii.bottom_left.0,
+                ],
+                misc: [backdrop.opacity, 1.0, 0.0, 0.0],
+            });
+            let first = (params.len() as u64 - 3) * self.stride;
+            self.plans.push(Some(Plan {
+                source_origin: [sx0, sy0],
+                source_size: [sx1 - sx0, sy1 - sy0],
+                offsets: [
+                    first as u32,
+                    (first + self.stride) as u32,
+                    (first + 2 * self.stride) as u32,
+                ],
+            }));
+        }
+        let needed = params.len() as u64 * self.stride;
+        if needed > self.uniform_capacity {
+            self.uniform_capacity = needed.next_power_of_two();
+            self.uniforms = Self::uniform_buffer(device, self.uniform_capacity);
+            self.scratch = None;
+        }
+        let mut bytes = vec![0u8; needed as usize];
+        for (index, param) in params.iter().enumerate() {
+            let start = index * self.stride as usize;
+            bytes[start..start + std::mem::size_of::<BackdropParams>()]
+                .copy_from_slice(bytemuck::bytes_of(param));
+        }
+        queue.write_buffer(&self.uniforms, 0, &bytes);
+        self.ensure_scratch(device, target_size);
+    }
+
+    fn ensure_scratch(&mut self, device: &wgpu::Device, size: [u32; 2]) {
+        if self
+            .scratch
+            .as_ref()
+            .is_some_and(|scratch| scratch.size == size)
+        {
+            return;
+        }
+        let texture = |label: &str, usage: wgpu::TextureUsages| {
+            device.create_texture(&wgpu::TextureDescriptor {
+                label: Some(label),
+                size: wgpu::Extent3d {
+                    width: size[0].max(1),
+                    height: size[1].max(1),
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: self.format,
+                usage: usage | wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            })
+        };
+        let group = |label: &str, view: &wgpu::TextureView| {
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some(label),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                            buffer: &self.uniforms,
+                            offset: 0,
+                            size: NonZeroU64::new(std::mem::size_of::<BackdropParams>() as u64),
+                        }),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: wgpu::BindingResource::TextureView(view),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: wgpu::BindingResource::Sampler(&self.sampler),
+                    },
+                ],
+            })
+        };
+        let copy = texture("backdrop_copy", wgpu::TextureUsages::COPY_DST);
+        let blur_x = texture("backdrop_blur_x", wgpu::TextureUsages::RENDER_ATTACHMENT);
+        let blur_y = texture("backdrop_blur_y", wgpu::TextureUsages::RENDER_ATTACHMENT);
+        let copy_view = copy.create_view(&wgpu::TextureViewDescriptor::default());
+        let blur_x_view = blur_x.create_view(&wgpu::TextureViewDescriptor::default());
+        let blur_y_view = blur_y.create_view(&wgpu::TextureViewDescriptor::default());
+        self.scratch = Some(Scratch {
+            size,
+            copy_group: group("backdrop_copy_group", &copy_view),
+            copy,
+            blur_x_group: group("backdrop_blur_x_group", &blur_x_view),
+            blur_x_view,
+            blur_y_group: group("backdrop_blur_y_group", &blur_y_view),
+            blur_y_view,
+        });
+    }
+
+    /// Records the blur of backdrop `index` onto `frame`. The caller has
+    /// ended its render pass on `frame` and starts a new one after this.
+    pub(crate) fn encode(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        index: usize,
+        frame: &wgpu::Texture,
+        frame_view: &wgpu::TextureView,
+    ) {
+        let (Some(Some(plan)), Some(scratch)) = (self.plans.get(index), self.scratch.as_ref())
+        else {
+            return;
+        };
+        encoder.copy_texture_to_texture(
