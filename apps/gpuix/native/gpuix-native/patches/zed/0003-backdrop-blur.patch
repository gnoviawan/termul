new file mode 100644
index 0000000..9782a34
--- /dev/null
+++ b/crates/gpui_wgpu/src/backdrop.wgsl
@@ -0,0 +1,80 @@
+// CSS `backdrop-filter: blur()`. Three passes per backdrop, all drawn by this
+// shader: a horizontal Gaussian that also downsamples (like Skia, the blur
+// runs at 1/scale resolution so sigma stays at or under 4 texels), a vertical
+// Gaussian at that resolution, and a composite that upsamples the result onto
+// the frame inside the element's rounded box.
+
+struct BackdropParams {
+    // Rectangle this pass draws, in render target pixels.
+    rect: vec4<f32>,
+    // xy: render target size; zw: source texture size.
+    sizes: vec4<f32>,
+    // Source position = target pixel centre * x + (y, z); w unused.
+    source_map: vec4<f32>,
+    // xy: one tap's step in source texels; z: sigma in taps; w: taps each side.
+    taps: vec4<f32>,
+    // Inclusive source range the taps are clamped to (texel centres).
+    source_clamp: vec4<f32>,
+    // Element bounds in target pixels, for the rounded mask.
+    bounds: vec4<f32>,
+    // Corner radii: top left, top right, bottom right, bottom left.
+    radii: vec4<f32>,
+    // x: opacity; y: 1 to apply the rounded mask.
+    misc: vec4<f32>,
+}
+
+@group(0) @binding(0) var<uniform> params: BackdropParams;
+@group(0) @binding(1) var source_texture: texture_2d<f32>;
+@group(0) @binding(2) var source_sampler: sampler;
+
+@vertex
+fn vs_backdrop(@builtin(vertex_index) vertex_id: u32) -> @builtin(position) vec4<f32> {
+    let corner = vec2<f32>(f32(vertex_id & 1u), f32(vertex_id >> 1u));
+    let pixel = params.rect.xy + corner * params.rect.zw;
+    let ndc = vec2<f32>(pixel.x / params.sizes.x * 2.0 - 1.0, 1.0 - pixel.y / params.sizes.y * 2.0);
+    return vec4<f32>(ndc, 0.0, 1.0);
+}
+
+fn rounded_coverage(point: vec2<f32>) -> f32 {
+    let half_size = params.bounds.zw * 0.5;
+    let center = params.bounds.xy + half_size;
+    let d = point - center;
+    var radius = params.radii.x;
+    if (d.x >= 0.0 && d.y < 0.0) {
+        radius = params.radii.y;
+    } else if (d.x >= 0.0 && d.y >= 0.0) {
+        radius = params.radii.z;
+    } else if (d.x < 0.0 && d.y >= 0.0) {
+        radius = params.radii.w;
+    }
+    radius = min(radius, min(half_size.x, half_size.y));
+    let q = abs(d) - half_size + radius;
+    let distance = length(max(q, vec2<f32>(0.0))) + min(max(q.x, q.y), 0.0) - radius;
+    return clamp(0.5 - distance, 0.0, 1.0);
+}
+
+@fragment
+fn fs_backdrop(@builtin(position) position: vec4<f32>) -> @location(0) vec4<f32> {
+    let center = position.xy * params.source_map.x + params.source_map.yz;
+    let step = params.taps.xy;
+    let sigma = params.taps.z;
+    let taps = i32(params.taps.w);
+    let inverse_size = 1.0 / params.sizes.zw;
+    var sum = vec4<f32>(0.0);
+    var weight_sum = 0.0;
+    for (var k = -taps; k <= taps; k++) {
+        let offset = f32(k);
+        var weight = 1.0;
+        if (taps > 0) {
+            weight = exp(-offset * offset / (2.0 * sigma * sigma));
+        }
+        let at = clamp(center + step * offset, params.source_clamp.xy, params.source_clamp.zw);
+        sum += textureSampleLevel(source_texture, source_sampler, at * inverse_size, 0.0) * weight;
+        weight_sum += weight;
+    }
+    var coverage = params.misc.x;
+    if (params.misc.y > 0.5) {
+        coverage *= rounded_coverage(position.xy);
+    }
+    return sum / weight_sum * coverage;
+}
