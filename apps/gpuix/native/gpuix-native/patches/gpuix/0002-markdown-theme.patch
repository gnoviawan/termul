+/// GPUI's per-run glyph scale (Termul's zed patch 0001-run-font-scale): a
+/// pseudo feature whose value is the scale in per mille.
+fn scaled_font(mut f: gpui::Font, scale: f32) -> gpui::Font {
+    if (scale - 1.0).abs() > f32::EPSILON {
+        let mut features: Vec<(String, u32)> = f.features.0.iter().cloned().collect();
+        features.push(("tszl".into(), (scale * 1000.0).round() as u32));
+        f.features = gpui::FontFeatures(std::sync::Arc::new(features));
+    }
+    f
+}
 
