+    /// What automation reads as the element's text: its content, or for a
+    /// `<markdown>` the text its source renders to.
+    pub fn automation_text(&self) -> Option<std::borrow::Cow<'_, str>> {
+        if let Some(content) = &self.content {
+            return Some(content.as_str().into());
+        }
+        if self.element_type != "markdown" {
+            return None;
+        }
+        let source = self.custom_props().get("source")?.as_str()?;
+        Some(crate::markdown::parser::plain_text(source).into())
+    }
