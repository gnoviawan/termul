+/// The text a reader sees: one line per paragraph, heading, list item and
+/// table row, table cells separated by tabs, code blocks verbatim. Automation
+/// reads it as a `<markdown>` element's text.
+pub fn plain_text(source: &str) -> String {
+    let mut out = String::new();
+    for block in &parse(source).blocks {
+        push_block_text(block, &mut out);
+    }
+    out.truncate(out.trim_end().len());
+    out
+}
+
+fn push_runs_text(runs: &[InlineRun], out: &mut String) {
+    for run in runs {
+        out.push_str(&run.text);
+    }
+}
+
+fn push_block_text(block: &Block, out: &mut String) {
+    match block {
+        Block::Paragraph { runs } | Block::Heading { runs, .. } => {
+            push_runs_text(runs, out);
+            out.push('\n');
+        }
+        Block::CodeBlock { code, .. } => {
+            out.push_str(code);
+            if !code.ends_with('\n') {
+                out.push('\n');
+            }
+        }
+        Block::BlockQuote { children } => children.iter().for_each(|b| push_block_text(b, out)),
+        Block::List { items, .. } => items.iter().flatten().for_each(|b| push_block_text(b, out)),
+        Block::Table { header, rows, .. } => {
+            for row in std::iter::once(header).chain(rows).filter(|row| !row.is_empty()) {
+                for (ix, cell) in row.iter().enumerate() {
+                    if ix > 0 {
+                        out.push('\t');
+                    }
+                    push_runs_text(cell, out);
+                }
+                out.push('\n');
+            }
+        }
+        Block::Rule => {}
+    }
+}
+
 fn options() -> Options {
     Options::ENABLE_TABLES | Options::ENABLE_STRIKETHROUGH | Options::ENABLE_TASKLISTS
 }
