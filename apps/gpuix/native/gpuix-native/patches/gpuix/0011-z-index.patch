diff --git a/packages/native/src/layer.rs b/packages/native/src/layer.rs
new file mode 100644
index 0000000..b0cc1f6
--- /dev/null
+++ b/packages/native/src/layer.rs
@@ -0,0 +1,204 @@
+//! Paint layers: the deferred `anchored` element and the `zIndex` style.
+//!
+//! GPUI paints in tree order, then its deferred draws sorted by priority. A
+//! positive `zIndex` puts an element in that deferred pass, at priority
+//! `zIndex`, while its layout stays in the flow: the CSS stacking order of
+//! positioned siblings, without moving any element in the tree.
+//!
+//! Deferred draws are sorted over the whole window, so a layer nested in
+//! another never gets a lower priority than the one around it: it would paint
+//! under its own container. The floor is the enclosing layer's priority.
+//!
+//! The build (`renderer::build_element`), the hit test
+//! (`RetainedTree::elements_at`) and the automation tree all read the layer
+//! from `of`, so what is hit and reported is what was painted.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use crate::retained_tree::RetainedElement;
+use crate::style::StyleDesc;
+use gpui::{
+    AnyElement, App, Bounds, ContentMask, Element, GlobalElementId, InspectorElementId,
+    IntoElement, LayoutId, Pixels, Window,
+};
+
+/// `anchored`'s own defaults; see `custom_elements::anchored`.
+const ANCHORED_PRIORITY: usize = 1;
+
+/// The priority this element paints at when it is a layer, given the
+/// enclosing layer's priority. `None` for an element painted in tree order.
+pub(crate) fn of(element: &RetainedElement, floor: Option<usize>) -> Option<usize> {
+    let own = if element.element_type == "anchored" {
+        let props = element.custom_props();
+        let deferred = props
+            .get("deferred")
+            .and_then(|value| value.as_bool())
+            .unwrap_or(true);
+        if !deferred {
+            return None;
+        }
+        props
+            .get("priority")
+            .and_then(|value| value.as_u64())
+            .map_or(ANCHORED_PRIORITY, |value| value as usize)
+    } else if element.element_type == "div" || element.element_type == "text" {
+        z_index(element.style.as_deref())?
+    } else {
+        return None;
+    };
+    Some(own.max(floor.unwrap_or(0)))
+}
+
+fn z_index(style: Option<&StyleDesc>) -> Option<usize> {
+    let z = style?.z_index?;
+    (z > 0).then_some(z as usize)
+}
+
+/// Paint `child` in the deferred pass at `priority`, keeping its layout here
+/// and the clip of the elements around it.
+pub(crate) fn lift(child: AnyElement, priority: usize) -> AnyElement {
+    let mask = Rc::new(RefCell::new(None));
+    Lift {
+        child: Some(
+            Clipped {
+                child,
+                mask: mask.clone(),
+            }
+            .into_any_element(),
+        ),
+        mask,
+        priority,
+    }
+    .into_any_element()
+}
+
+/// In the tree: lays the child out, then hands it to the deferred pass.
+struct Lift {
+    child: Option<AnyElement>,
+    mask: Rc<RefCell<Option<ContentMask<Pixels>>>>,
+    priority: usize,
+}
+
+/// In the deferred pass: the child under the clip it had in the tree.
+/// gpui's deferred prepaint runs without the recorded clip (only the paint
+/// gets it), so hitboxes would otherwise reach past a scroll container.
+struct Clipped {
+    child: AnyElement,
+    mask: Rc<RefCell<Option<ContentMask<Pixels>>>>,
+}
+
+impl IntoElement for Lift {
+    type Element = Self;
+    fn into_element(self) -> Self {
+        self
+    }
+}
+
+impl IntoElement for Clipped {
+    type Element = Self;
+    fn into_element(self) -> Self {
+        self
+    }
+}
+
+impl Element for Lift {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+
+    fn id(&self) -> Option<gpui::ElementId> {
+        None
+    }
+
+    fn source_location(&self) -> Option<&'static std::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, ()) {
+        let child = self.child.as_mut().expect("a lift is laid out once");
+        (child.request_layout(window, cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        window: &mut Window,
+        _: &mut App,
+    ) {
+        let Some(child) = self.child.take() else { return };
+        let mask = window.content_mask();
+        *self.mask.borrow_mut() = Some(mask.clone());
+        let offset = window.element_offset();
+        window.defer_draw(child, offset, self.priority, Some(mask));
+    }
+
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        _: &mut (),
+        _: &mut Window,
+        _: &mut App,
+    ) {
+    }
+}
+
+impl Element for Clipped {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+
+    fn id(&self) -> Option<gpui::ElementId> {
+        None
+    }
+
+    fn source_location(&self) -> Option<&'static std::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, ()) {
+        (self.child.request_layout(window, cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let mask = self.mask.borrow().clone();
+        window.with_content_mask(mask, |window| self.child.prepaint(window, cx));
+    }
+
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        _: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        self.child.paint(window, cx);
+    }
+}
