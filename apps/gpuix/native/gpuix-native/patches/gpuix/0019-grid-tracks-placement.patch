+/// One `grid-template-columns` track, as Termul's compat layer parses it.
+#[derive(Debug, Clone, Copy, PartialEq, Deserialize, Serialize)]
+#[serde(tag = "kind", rename_all = "lowercase")]
+pub enum GridTrackDesc {
+    Fixed { px: f64 },
+    Fr { fr: f64, min: f64 },
+    Content,
+}
+
+impl GridTrackDesc {
+    pub fn to_gpui(self) -> gpui::GridTrackSize {
+        match self {
+            Self::Fixed { px } => gpui::GridTrackSize::Fixed(px as f32),
+            Self::Fr { fr, min } => gpui::GridTrackSize::Fraction {
+                fr: fr as f32,
+                min: min as f32,
+            },
+            Self::Content => gpui::GridTrackSize::Auto,
+        }
+    }
+}
+
 /// Style description that can be serialized from JS
