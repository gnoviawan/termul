+#[derive(Debug, Clone, PartialEq)]
+#[cfg_attr(not(all(target_arch = "wasm32", target_os = "unknown")), napi(object))]
+pub struct NativeWindowHandle {
+    /// `"x11"`, `"wayland"`, `"appkit"` or `"win32"`.
+    pub kind: String,
+    /// The X11 window id or the Win32 HWND. Absent where the platform has no
+    /// id another process can use (Wayland, AppKit).
+    pub id: Option<f64>,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn native_window_handle(window: &gpui::Window) -> Option<NativeWindowHandle> {
+    use gpui::raw_window_handle::{HasWindowHandle, RawWindowHandle};
+    let handle = HasWindowHandle::window_handle(window).ok()?;
+    let (kind, id) = match handle.as_raw() {
+        RawWindowHandle::Xcb(h) => ("x11", Some(h.window.get() as f64)),
+        RawWindowHandle::Xlib(h) => ("x11", Some(h.window as f64)),
+        RawWindowHandle::Wayland(_) => ("wayland", None),
+        RawWindowHandle::AppKit(_) => ("appkit", None),
+        RawWindowHandle::Win32(h) => ("win32", Some(h.hwnd.get() as f64)),
+        _ => return None,
+    };
+    Some(NativeWindowHandle {
+        kind: kind.to_string(),
+        id,
+    })
+}
+
