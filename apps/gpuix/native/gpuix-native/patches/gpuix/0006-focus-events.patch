+
+    /// Focus and blur are derived from the focused handle each frame instead
+    /// of per-element GPUI focus listeners. GPUI activates a listener only
+    /// after the frame that created it, so an element focused as it mounted
+    /// (`autoFocus`, `focusElement`) never got its focus event, and listeners
+    /// run in creation order, so a newer element's focus could arrive before
+    /// the older one's blur. Every focus change and window (de)activation
+    /// refreshes the window, so this runs after each one. Like the DOM: blur
+    /// before focus, nothing for an element that is gone, and an inactive
+    /// window has no focused element.
+    fn emit_focus_events(
+        &mut self,
+        tree: &RetainedTree,
+        callback: &Option<EventCallback>,
+        window: &gpui::Window,
+        cx: &gpui::App,
+    ) {
+        let focused = window
+            .is_window_active()
+            .then(|| window.focused(cx))
+            .flatten()
+            .and_then(|focused| {
+                self.focus_handles
+                    .iter()
+                    .find(|(_, handle)| handle.id() == focused.id())
+                    .map(|(&id, _)| id)
+            });
+        if focused == self.focus_event_target {
+            return;
+        }
+        let listens = |id: u64, event: &str| {
+            tree.elements
+                .get(&id)
+                .is_some_and(|element| element.events().contains(event))
+        };
+        if let Some(previous) = self.focus_event_target.filter(|&id| listens(id, "blur")) {
+            emit_event_full(callback, previous, "blur", |_| {});
+        }
+        if let Some(current) = focused.filter(|&id| listens(id, "focus")) {
+            emit_event_full(callback, current, "focus", |_| {});
+        }
+        self.focus_event_target = focused;
     }
 }
 
