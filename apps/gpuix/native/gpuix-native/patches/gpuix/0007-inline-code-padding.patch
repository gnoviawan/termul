+/// GPUI's per-run inline padding (Termul's zed patch 0004-run-padding): a
+/// pseudo feature whose value is the padding in hundredths of a pixel, laid
+/// out on both sides of the run like CSS inline padding.
+fn padded_font(mut f: gpui::Font, pad: f32) -> gpui::Font {
+    if pad > 0.0 {
+        let mut features: Vec<(String, u32)> = f.features.0.iter().cloned().collect();
+        features.push(("tpdx".into(), (pad * 100.0).round() as u32));
+        f.features = gpui::FontFeatures(std::sync::Arc::new(features));
+    }
+    f
+}
