+    #[test]
+    fn lead_tabular_nums_sets_only_the_opening_digits_tabular() {
+        let mut theme = Theme::dark();
+        theme.lead_tabular_nums = true;
+        let flat = flatten_runs(
+            &[run("12. Read 3 files", InlineStyle::default())],
+            &theme,
+            FontWeight::NORMAL,
+        );
+        let tnum = |r: &TextRun| r.font.features.0.iter().any(|(tag, on)| tag == "tnum" && *on == 1);
+        assert_eq!(flat.runs.iter().map(|r| r.len).collect::<Vec<_>>(), vec![2, 14]);
+        assert!(tnum(&flat.runs[0]));
+        assert!(!tnum(&flat.runs[1]));
+
+        theme.lead_tabular_nums = false;
+        let plain = flatten_runs(&[run("12. Read", InlineStyle::default())], &theme, FontWeight::NORMAL);
+        assert_eq!(plain.runs.len(), 1);
+    }
