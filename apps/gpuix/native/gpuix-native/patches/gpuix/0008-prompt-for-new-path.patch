+    /// Open the platform save dialog in `directory`, prefilled with `suggestedName`.
+    /// Resolves to the chosen path, or null when the user cancels.
+    #[napi(ts_return_type = "Promise<string | null>")]
+    pub fn prompt_for_new_path<'env>(
+        &self,
+        env: &'env Env,
+        options: NewPathPromptOptions,
+    ) -> Result<Object<'env>> {
+        let (deferred, promise): (NewPathPromptDeferred, Object<'env>) = env.create_deferred()?;
+        self.begin_new_path_prompt(
+            std::path::PathBuf::from(options.directory),
+            options.suggested_name,
+            deferred,
+        );
+        Ok(promise)
+    }
