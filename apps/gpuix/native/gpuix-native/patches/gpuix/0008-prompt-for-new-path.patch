+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+type NewPathPromptReceiver = oneshot::Receiver<anyhow::Result<Option<std::path::PathBuf>>>;
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+type NewPathPromptResolver = Box<dyn FnOnce(Env) -> Result<Option<String>> + Send>;
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+type NewPathPromptDeferred = JsDeferred<Option<String>, NewPathPromptResolver>;
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn new_path_prompt_result(
+    result: anyhow::Result<Option<std::path::PathBuf>>,
+) -> Result<Option<String>> {
+    result
+        .map_err(|error| Error::from_reason(error.to_string()))?
+        .map(|path| {
+            path.into_os_string()
+                .into_string()
+                .map_err(|_| Error::from_reason("The selected path is not valid Unicode"))
+        })
+        .transpose()
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn settle_new_path_prompt(
+    executor: gpui::BackgroundExecutor,
+    receiver: NewPathPromptReceiver,
+    deferred: NewPathPromptDeferred,
+) {
+    executor
+        .spawn(async move {
+            let result = receiver
+                .await
+                .map_err(|_| Error::from_reason("The save prompt closed without a result"))
+                .and_then(new_path_prompt_result);
+            match result {
+                Ok(path) => deferred.resolve(Box::new(move |_env| Ok(path))),
+                Err(error) => deferred.reject(error),
+            }
+        })
+        .detach();
+}
