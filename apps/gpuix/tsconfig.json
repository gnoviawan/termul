{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "paths": {
      "@/*": ["../../src/renderer/*"],
      "@renderer/*": ["../../src/renderer/*"],
      "@shared/*": ["../../src/shared/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "noEmit": true
  },
  "include": [
    "src/window.ts",
    "src/shims",
    "src/style",
    "src/compat",
    "src/ui",
    "src/icons",
    "src/composer",
    "src/overrides/components/chat/composer",
    "../../src/renderer/vite-env.d.ts"
  ],
  "exclude": ["src/style/fonts.ts", "src/style/__tests__", "src/composer/__tests__", "src/compat/radix", "src/compat/shims"]
}
