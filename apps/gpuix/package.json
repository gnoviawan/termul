{
  "name": "@termul/gpuix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Termul desktop client rendered natively with GPUIX (React on Zed's GPUI)",
  "imports": {
    "#app/boot": "./src/boot.tsx"
  },
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun tools/dev.ts",
    "start": "bun build.ts && bun dist/main.js",
    "check:react": "bun tools/check-react.ts",
    "parity": "bun tools/parity/index.ts",
    "perf": "bun tools/perf/run.ts",
    "perf:report": "bun tools/perf/report.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.tools.json",
    "test": "bun test src/style",
    "style:scan": "bun tools/style/scan-classes.ts",
    "style:gen": "bun tools/style/gen-color-vars.ts",
    "style:fonts": "uv run --with fonttools --with brotli python -I tools/style/build-fonts.py",
    "style:showcase": "bun tools/style/showcase/run.ts",
    "style:oracle": "bun tools/style/oracle.ts"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@types/bun": "1.4.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
