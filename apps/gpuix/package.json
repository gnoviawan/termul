{
  "name": "@termul/gpuix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Termul desktop client rendered natively with GPUIX (React on Zed's GPUI)",
  "imports": {
    "#app/boot": "./src/boot.tsx",
    "#app/web-root": "./src/app/web-root.ts",
    "#compat/fixture-boot": "./tools/compat/fixtures/boot.tsx",
    "#compat/fixture-dom": "./tools/compat/fixtures/dom/index.tsx",
    "#compat/bench-app": "./tools/compat/bench/app.tsx",
    "#compat/bench-dom": "./tools/compat/bench/dom/CompatList.tsx"
  },
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun tools/dev.ts",
    "start": "bun build.ts && bun dist/main.js",
    "check:react": "bun tools/check-react.ts",
    "compat:lint": "bun tools/compat/lint.ts",
    "parity": "bun tools/parity/index.ts",
    "perf": "bun tools/perf/run.ts",
    "perf:report": "bun tools/perf/report.ts",
    "perf:runs": "bun tools/perf/runs-report.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.tools.json && tsc -p tsconfig.terminal.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.compat.json && tsc -p tsconfig.compat-app.json && tsc -p tsconfig.chat.json && tsc -p tsconfig.composer.json && tsc -p tsconfig.editor.json",
    "test": "bun test src/env src/editor src/style src/terminal src/ui src/chat src/composer tools/ui tools/launcher tools/compat tools/composer",
    "style:scan": "bun tools/style/scan-classes.ts",
    "style:gen": "bun tools/style/gen-color-vars.ts",
    "style:fonts": "uv run --with fonttools --with brotli python -I tools/style/build-fonts.py",
    "style:showcase": "bun tools/style/showcase/run.ts",
    "style:oracle": "bun tools/style/oracle.ts",
    "ui:gallery": "bun tools/ui/gallery/run.ts",
    "ui:interact": "bun tools/ui/gallery/interact.ts",
    "ui:icons": "bun tools/ui/gen-icons.ts",
    "chat:seed": "bun tools/chat/seed.ts",
    "chat:parity": "bun tools/chat/parity.ts",
    "chat:check": "bun tools/chat/check.ts",
    "chat:perf": "bun tools/chat/perf.ts",
    "terminal:demo": "bun tools/terminal/demo.ts",
    "terminal:parity": "bun tools/terminal/parity.ts",
    "terminal:throughput": "bun tools/terminal/throughput.ts",
    "terminal:pane": "bun tools/terminal/pane-check.ts",
    "terminal:shell": "bun tools/terminal/shell-check.ts"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@xterm/headless": "6.1.0-beta.287",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@types/bun": "1.4.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "pixelmatch": "7.1.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "wawoff2": "2.0.1"
  }
}
