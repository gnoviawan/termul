{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["bun"],
    "paths": {
      "#compat/fixture-boot": ["./tools/compat/fixtures/boot-contract.ts"],
      "#compat/bench-app": ["./tools/compat/bench/app-contract.ts"],
      "@/*": ["../../src/renderer/*"],
      "@renderer/*": ["../../src/renderer/*"],
      "@shared/*": ["../../src/shared/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "#app/boot": ["./src/boot-contract.ts"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/env",
    "src/log.ts",
    "build.ts",
    "tools",
    "src/style/fonts.ts",
    "src/style/__tests__"
  ],
  "exclude": ["tools/terminal", "tools/ui/gallery", "tools/compat/fixtures/dom", "tools/compat/bench/dom", "src/compat/radix", "src/compat/shims", "tools/compat/web/main.tsx", "tools/compat/fixtures/boot.tsx", "tools/compat/bench/app.tsx", "tools/compat/bench/HandList.tsx", "tools/compat/bench/data.ts"]
}
